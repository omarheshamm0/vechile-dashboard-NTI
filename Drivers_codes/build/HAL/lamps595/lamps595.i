{
 if (GPIO_SetPinDirection(2u, 2u, 1u) == E_NOK)
 {
  return E_NOK;
 }

 if (GPIO_SetPinValue(2u, 2u, 0u) == E_NOK)
 {
  return E_NOK;
 }

 Local_u8LampByte = 0u;
 Local_u8BulbCheckActive = 0u;
